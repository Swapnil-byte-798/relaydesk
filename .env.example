# All values are optional for the Python CLI.
RELAYDESK_DATABASE_URL=sqlite:///.relaydesk/relaydesk.db
# To use PostgreSQL: install .[postgres] and set postgresql+psycopg://...
RELAYDESK_HOME=.relaydesk
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# API authentication. If unset, `relaydesk init` creates a private local token file.
RELAYDESK_API_TOKEN=
# Docker Compose only: use a random hex password to keep it URL-safe.
POSTGRES_PASSWORD=
